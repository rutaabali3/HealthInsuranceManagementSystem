@{ ViewData["Title"] = "About Us"; }

<section class="about-hero" aria-labelledby="about-title">
    <img class="hero-background-image" src="~/images/about/hero.png" alt="" aria-hidden="true" />
    <div class="about-hero-copy">
        <span class="about-kicker"><i class="bi bi-heart-pulse"></i> &nbsp; About HealthInsure</span>
        <h1 id="about-title">About HealthInsure</h1>
        <p>Empowering organizations with smarter health insurance management.</p>
        <a class="btn btn-primary" href="#about-story"><i class="bi bi-arrow-right ms-2"></i> Learn More</a>
    </div>
</section>

<section class="about-story" id="about-story" aria-label="About HealthInsure story and mission">
    <div class="story-image">
        <img src="~/images/about/section.png" alt="Health insurance team reviewing reports" />
    </div>

    <article class="story-copy">
        <div class="section-heading">
            <span><i class="bi bi-book"></i></span>
            <h2>Our Story</h2>
        </div>
        <p>
            The Health Insurance Management System (HIMS) is an enterprise-grade web
            application designed to streamline corporate health insurance.
        </p>
        <p>
            Our platform provides a fully integrated solution covering employee registration,
            policy management, claim tracking, and comprehensive reporting - reducing
            manual overhead and improving transparency across your organization.
        </p>
    </article>

    <article class="mission-copy">
        <div class="section-heading">
            <span><i class="bi bi-bullseye"></i></span>
            <h2>Our Mission</h2>
        </div>
        <p>
            To provide organizations with a reliable, user-friendly health insurance
            management platform that ensures every employee has easy access to their
            medical coverage information and can request policies without friction.
        </p>
    </article>
</section>

<section class="about-features" aria-labelledby="features-title">
    <h2 id="features-title">Everything you need to manage health insurance-effortlessly</h2>

    <div class="about-feature-grid">
        <article class="about-feature-card">
            <span><i class="bi bi-buildings"></i></span>
            <div>
                <h3>Insurance Provider Management</h3>
                <p>Effortlessly manage policies across multiple entities from a single platform.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-person-heart"></i></span>
            <div>
                <h3>Employee Self-Service</h3>
                <p>Empower employees with a dedicated portal for access and requests.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-door-open-fill"></i></span>
            <div>
                <h3>Automated Workflows</h3>
                <p>Streamline policy requests and approval processes efficiently.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-file-earmark-check-fill"></i></span>
            <div>
                <h3>Policy Request Approvals</h3>
                <p>Review employee policy requests through manager and finance workflows.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-calendar-week"></i></span>
            <div>
                <h3>Date-range Reporting</h3>
                <p>Generate comprehensive reports based on specific date ranges.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-bar-chart-fill"></i></span>
            <div>
                <h3>Accurate Reporting</h3>
                <p>Generate comprehensive reports based on specific date ranges and metrics.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-shield-lock-fill"></i></span>
            <div>
                <h3>Secure Role-based Access</h3>
                <p>Ensure data security with granular access controls for admins and employees.</p>
            </div>
        </article>

        <article class="about-feature-card">
            <span><i class="bi bi-hospital"></i></span>
            <div>
                <h3>Claims and Coverage Tracking</h3>
                <p>Track employee claims, assigned policies, and available coverage from one system.</p>
            </div>
        </article>
    </div>
</section>
