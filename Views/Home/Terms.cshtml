@{ ViewData["Title"] = "Terms"; }

<section class="info-page-shell" aria-labelledby="terms-title">
    <header class="info-page-header">
        <span><i class="bi bi-file-earmark-text"></i></span>
        <h1 id="terms-title">Terms</h1>
        <p>Basic usage terms for the Health Insurance Management System.</p>
    </header>

    <div class="info-page-content">
        <article>
            <h2>Authorized Use</h2>
            <p>
                This system is intended for authorized users managing health insurance information,
                employee requests, approvals, billing, and reporting.
            </p>
        </article>

        <article>
            <h2>Account Responsibility</h2>
            <p>
                Users are responsible for keeping their login details safe and for using the system
                according to their assigned role.
            </p>
        </article>

        <article>
            <h2>Workflow Accuracy</h2>
            <p>
                Admin, manager, and finance actions should be reviewed carefully before submission,
                because these actions update request and billing records.
            </p>
        </article>
    </div>
</section>
