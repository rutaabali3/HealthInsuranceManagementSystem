@model ContactFormViewModel

@{ ViewData["Title"] = "Contact Us"; }

<section class="contact-hero" aria-labelledby="contact-title">
    <video class="hero-background-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="~/images/contact/hero.mp4" type="video/mp4" />
    </video>
    <div class="contact-hero-copy">
        <span><i class="bi bi-headset"></i> &nbsp; Get In Touch</span>
        <h1 id="contact-title">We're Here to Help</h1>
        <p>Reach out to our team for any inquiries about the Health Insurance Management System.</p>
    </div>
        @* <div class="contact-hero-image" aria-hidden="true">
        <img src="~/images/contact/hero-right.png" alt="" />
    </div> *@
</section>

<section class="contact-layout" aria-label="Contact details and message form">
    <aside class="contact-info-card">
        <h2>Contact Information</h2>

        <div class="contact-info-list">
            <div class="contact-info-item">
                <span class="contact-icon"><i class="bi bi-envelope"></i></span>
                <div>
                    <strong>Email</strong>
                    <span>support@healthinsure.com</span>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon"><i class="bi bi-telephone-fill"></i></span>
                <div>
                    <strong>Phone</strong>
                    <span>+92-21-1234567</span>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon"><i class="bi bi-geo-alt-fill"></i></span>
                <div>
                    <strong>Address</strong>
                    <span>Health Insurance House, I.I. Chundrigar Road, Karachi</span>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon"><i class="bi bi-clock-fill"></i></span>
                <div>
                    <strong>Office Hours</strong>
                    <span>Monday - Friday, 9:00 AM - 5:00 PM</span>
                </div>
            </div>
        </div>

        <div class="response-note">
            <i class="bi bi-shield-check"></i>
            <span>We typically respond within 24 hours during business days.</span>
        </div>
    </aside>

    <section class="message-card" aria-labelledby="message-title">
        <h2 id="message-title">Send Us a Message</h2>
        <p>Fill out the form and our team will get back to you shortly.</p>

        <form asp-controller="Home" asp-action="Contact" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="app-validation-summary text-danger validation-summary-valid"></div>
            <div class="form-row">
                <div class="form-field">
                    <label asp-for="ContactName" class="form-label"></label>
                    <div class="input-group app-field-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="ContactName" type="text" class="form-control" placeholder="John Doe" required />
                    </div>
                    <span asp-validation-for="ContactName" class="text-danger small"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ContactEmail" class="form-label"></label>
                    <div class="input-group app-field-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="ContactEmail" type="email" class="form-control" placeholder="john@example.com" required />
                    </div>
                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="ContactMessage" class="form-label"></label>
                <div class="input-group app-field-group">
                    <span class="input-group-text"><i class="bi bi-chat-left-text"></i></span>
                    <textarea asp-for="ContactMessage" class="form-control" rows="6" placeholder="How can we help?" required></textarea>
                </div>
                <span asp-validation-for="ContactMessage" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary message-submit" type="submit">
                <i class="bi bi-send"></i>
                <span>Send Message</span>
            </button>
        </form>
    </section>
</section>
