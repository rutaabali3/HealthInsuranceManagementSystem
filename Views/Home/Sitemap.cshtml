@{
    ViewData["Title"] = "Sitemap";

    var role = Context.Session.GetString("Role");
    var isAdmin = role == UserRoles.Admin || role == "Admin";
    var isManager = role == UserRoles.Manager;
    var isFinance = role == UserRoles.FinanceManager;
    var isSupport = role == UserRoles.Support;
    var isEmployee = role == UserRoles.Employee || role == "Employee";
    var hasRole = isAdmin || isManager || isFinance || isSupport || isEmployee;
}

<section class="info-page-shell" aria-labelledby="sitemap-title">
    <header class="info-page-hero">
        <div class="info-page-hero-copy">
            <span class="info-kicker"><i class="bi bi-diagram-3"></i> Site Directory</span>
            <h1 id="sitemap-title">Sitemap</h1>
            <p>
                Use this directory to move quickly between public information pages, account access,
                and the HealthInsure areas available to your account.
            </p>
        </div>

        <div class="info-hero-panel" aria-label="Sitemap highlights">
            <div>
                <i class="bi bi-compass"></i>
                <strong>Quick navigation</strong>
                <span>Public pages, account help, and role dashboards are grouped by purpose.</span>
            </div>
            <div>
                <i class="bi bi-grid"></i>
                <strong>Access-aware map</strong>
                <span>Role links appear only for the account currently signed in.</span>
            </div>
        </div>
    </header>

    <div class="sitemap-grid">
        <article>
            <span class="info-card-icon"><i class="bi bi-house-door"></i></span>
            <h2>Public Pages</h2>
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-right"></i> Home</a>
            <a asp-controller="Home" asp-action="About"><i class="bi bi-arrow-right"></i> About Us</a>
            <a asp-controller="Home" asp-action="Contact"><i class="bi bi-arrow-right"></i> Contact</a>
        </article>

        <article>
            <span class="info-card-icon"><i class="bi bi-person-circle"></i></span>
            <h2>Account</h2>
            <a asp-controller="Auth" asp-action="Login"><i class="bi bi-arrow-right"></i> Login</a>
            <a asp-controller="Auth" asp-action="ForgotPassword"><i class="bi bi-arrow-right"></i> Forgot Password</a>
        </article>

        <article>
            <span class="info-card-icon"><i class="bi bi-info-square"></i></span>
            <h2>Information</h2>
            <a asp-controller="Home" asp-action="Privacy"><i class="bi bi-arrow-right"></i> Privacy</a>
            <a asp-controller="Home" asp-action="Terms"><i class="bi bi-arrow-right"></i> Terms</a>
            <a asp-controller="Home" asp-action="Sitemap"><i class="bi bi-arrow-right"></i> Sitemap</a>
        </article>

        @if (isAdmin)
        {
            <article>
                <span class="info-card-icon"><i class="bi bi-speedometer2"></i></span>
                <h2>Admin Area</h2>
                <a asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-arrow-right"></i> Dashboard</a>
                <a asp-controller="Admin" asp-action="Companies"><i class="bi bi-arrow-right"></i> Companies</a>
                <a asp-controller="Admin" asp-action="Policies"><i class="bi bi-arrow-right"></i> Policies</a>
                <a asp-controller="Admin" asp-action="Employees"><i class="bi bi-arrow-right"></i> Employees</a>
                <a asp-controller="Admin" asp-action="PolicyRequests"><i class="bi bi-arrow-right"></i> Policy Requests</a>
                <a asp-controller="Report" asp-action="Index"><i class="bi bi-arrow-right"></i> Reports</a>
            </article>
        }

        @if (isEmployee)
        {
            <article>
                <span class="info-card-icon"><i class="bi bi-person-heart"></i></span>
                <h2>Employee Area</h2>
                <a asp-controller="Employee" asp-action="Dashboard"><i class="bi bi-arrow-right"></i> Dashboard</a>
                <a asp-controller="Employee" asp-action="SearchPolicy"><i class="bi bi-arrow-right"></i> Search Policy</a>
                <a asp-controller="Employee" asp-action="Details"><i class="bi bi-arrow-right"></i> My Details</a>
                <a asp-controller="Employee" asp-action="ChangePassword"><i class="bi bi-arrow-right"></i> Change Password</a>
            </article>
        }

        @if (isManager)
        {
            <article>
                <span class="info-card-icon"><i class="bi bi-briefcase"></i></span>
                <h2>Manager Area</h2>
                <a asp-controller="Manager" asp-action="Dashboard"><i class="bi bi-arrow-right"></i> Dashboard</a>
                <a asp-controller="Manager" asp-action="Requests"><i class="bi bi-arrow-right"></i> Requests</a>
                <a asp-controller="Manager" asp-action="Details"><i class="bi bi-arrow-right"></i> My Details</a>
                <a asp-controller="Manager" asp-action="UpdateDetails"><i class="bi bi-arrow-right"></i> Update Details</a>
            </article>
        }

        @if (isFinance)
        {
            <article>
                <span class="info-card-icon"><i class="bi bi-cash-coin"></i></span>
                <h2>Finance Area</h2>
                <a asp-controller="Finance" asp-action="Dashboard"><i class="bi bi-arrow-right"></i> Dashboard</a>
                <a asp-controller="Finance" asp-action="Requests"><i class="bi bi-arrow-right"></i> Requests</a>
                <a asp-controller="Finance" asp-action="Details"><i class="bi bi-arrow-right"></i> My Details</a>
                <a asp-controller="Finance" asp-action="UpdateDetails"><i class="bi bi-arrow-right"></i> Update Details</a>
            </article>
        }

        @if (isSupport)
        {
            <article>
                <span class="info-card-icon"><i class="bi bi-headset"></i></span>
                <h2>Support Area</h2>
                <a asp-controller="Support" asp-action="Dashboard"><i class="bi bi-arrow-right"></i> Dashboard</a>
                <a asp-controller="Support" asp-action="Inbox"><i class="bi bi-arrow-right"></i> Inbox</a>
                <a asp-controller="Support" asp-action="Details"><i class="bi bi-arrow-right"></i> My Details</a>
                <a asp-controller="Support" asp-action="UpdateDetails"><i class="bi bi-arrow-right"></i> Update Details</a>
            </article>
        }
    </div>

    <aside class="info-callout">
        @if (hasRole)
        {
            <i class="bi bi-person-check-fill"></i>
            <div>
                <strong>Your sitemap is filtered</strong>
                <p>Only links for your signed-in role are shown here, along with public information pages.</p>
            </div>
            <a asp-controller="Auth" asp-action="Logout">Logout</a>
        }
        else
        {
            <i class="bi bi-lock-fill"></i>
            <div>
                <strong>Role areas are hidden</strong>
                <p>Sign in to see the sitemap section that belongs to your account role.</p>
            </div>
            <a asp-controller="Auth" asp-action="Login">Go to Login</a>
        }
    </aside>
</section>
