@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
    var managerName = $"{Model.Manager?.FirstName} {Model.Manager?.LastName}".Trim();
    var today = DateTime.Now;
    var waitingCount = Model.ReceivedBills.Count(b => b.Status == "Created");
    var approvedCount = Model.ReceivedBills.Count(b => b.Status == "ManagerApproved");
    var forwardedCount = Model.ReceivedBills.Count(b => b.Status == "ForwardedToFinance");
    var rejectedCount = Model.ReceivedBills.Count(b => b.Status == "Rejected");
    var pendingClaimCount = Model.PendingClaims.Count;
}

<section class="role-dashboard-shell manager-dashboard-shell">
    <header class="role-dashboard-hero">
        <div>
            <p class="role-dashboard-eyebrow">Manager Workspace</p>
            <h1>Received Bills</h1>
            <p class="role-dashboard-subtitle">Review employee insurance bills and forward approved payments to finance.</p>
        </div>
        <div class="role-hero-actions">
            <span class="role-date-chip">
                <i class="bi bi-calendar3"></i>
                <span>@today.ToString("MMMM d, yyyy")</span>
            </span>
            <span class="role-user-chip">
                <i class="bi bi-person-badge"></i>
                <span>@(string.IsNullOrWhiteSpace(managerName) ? "Manager" : managerName)</span>
            </span>
        </div>
    </header>

    <section class="role-metric-grid" aria-label="Manager bill metrics">
        <article class="role-metric-card metric-card-amber">
            <span class="role-metric-icon"><i class="bi bi-hourglass-split"></i></span>
            <span class="role-metric-content">
                <strong>@waitingCount</strong>
                <span>Waiting Approval</span>
            </span>
        </article>
        <article class="role-metric-card metric-card-green">
            <span class="role-metric-icon"><i class="bi bi-check2-circle"></i></span>
            <span class="role-metric-content">
                <strong>@approvedCount</strong>
                <span>Ready to Forward</span>
            </span>
        </article>
        <article class="role-metric-card metric-card-blue">
            <span class="role-metric-icon"><i class="bi bi-send-check"></i></span>
            <span class="role-metric-content">
                <strong>@forwardedCount</strong>
                <span>Forwarded</span>
            </span>
        </article>
        <article class="role-metric-card metric-card-red">
            <span class="role-metric-icon"><i class="bi bi-x-circle"></i></span>
            <span class="role-metric-content">
                <strong>@rejectedCount</strong>
                <span>Rejected</span>
            </span>
        </article>
        <article class="role-metric-card metric-card-teal">
            <span class="role-metric-icon"><i class="bi bi-clipboard-pulse"></i></span>
            <span class="role-metric-content">
                <strong>@pendingClaimCount</strong>
                <span>Pending Claims</span>
            </span>
        </article>
    </section>

    <article class="role-dashboard-panel">
        <div class="role-panel-heading">
            <h2><i class="bi bi-clipboard-check"></i>Bill Queue</h2>
            <a asp-action="Requests" class="panel-action">View All</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle role-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Employee</th>
                        <th>Policy</th>
                        <th>Company</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ReceivedBills.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="role-empty-state">
                                    <span><i class="bi bi-inbox"></i></span>
                                    <strong>No bills received.</strong>
                                    <small>Employee bill requests will appear here after they are generated.</small>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var bill in Model.ReceivedBills)
                    {
                        <tr>
                            <td>@bill.BillId</td>
                            <td class="fw-semibold">@bill.PolicyRequest?.Employee?.FirstName @bill.PolicyRequest?.Employee?.LastName</td>
                            <td>@bill.PolicyRequest?.Policy?.PolicyName</td>
                            <td>@bill.PolicyRequest?.Policy?.Company?.CompanyName</td>
                            <td>PKR @bill.Amount.ToString("N0")</td>
                            <td>
                                <span class="status-pill @(bill.Status=="Created"?"status-waiting":bill.Status=="Rejected"?"status-rejected":bill.Status=="ForwardedToFinance"?"status-forwarded":"status-approved")">
                                    @bill.Status
                                </span>
                            </td>
                            <td>
                                <div class="manager-action-row">
                                    <a asp-action="RequestDetails" asp-route-id="@bill.RequestId" class="btn btn-sm btn-outline-secondary action-button">
                                        <i class="bi bi-eye"></i><span>View</span>
                                    </a>
                                    @if (bill.Status == "Created")
                                    {
                                        <form asp-action="Decide" method="post"
                                              data-swal-title="Approve bill"
                                              data-swal-confirm="Approve this bill?"
                                              data-swal-confirm-button="Approve">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="billId" value="@bill.BillId" />
                                            <input type="hidden" name="decision" value="Approved" />
                                            <input type="hidden" name="remarks" value="Approved by manager." />
                                            <button type="submit" class="btn btn-sm btn-success action-button">
                                                <i class="bi bi-check-lg"></i><span>Approve</span>
                                            </button>
                                        </form>
                                        <form asp-action="Decide" method="post"
                                              data-swal-title="Reject bill"
                                              data-swal-confirm="Reject this bill?"
                                              data-swal-confirm-button="Reject">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="billId" value="@bill.BillId" />
                                            <input type="hidden" name="decision" value="Rejected" />
                                            <input type="hidden" name="remarks" value="Rejected by manager." />
                                            <button type="submit" class="btn btn-sm btn-danger action-button">
                                                <i class="bi bi-x-lg"></i><span>Reject</span>
                                            </button>
                                        </form>
                                    }
                                    else if (bill.Status == "ManagerApproved")
                                    {
                                        <form asp-action="ForwardToFinance" method="post"
                                              data-swal-title="Forward bill"
                                              data-swal-confirm="Forward this bill to finance?"
                                              data-swal-confirm-button="Forward">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="billId" value="@bill.BillId" />
                                            <button type="submit" class="btn btn-sm btn-primary action-button">
                                                <i class="bi bi-send"></i><span>Forward</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <article class="role-dashboard-panel">
        <div class="role-panel-heading">
            <h2><i class="bi bi-clipboard-pulse"></i>Claim Queue</h2>
            <a asp-action="Claims" class="panel-action">View All</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle role-table mb-0">
                <thead>
                    <tr><th>#</th><th>Employee</th><th>Policy</th><th>Amount</th><th>Status</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @if (!Model.PendingClaims.Any())
                    {
                        <tr><td colspan="6"><div class="role-empty-state"><span><i class="bi bi-inbox"></i></span><strong>No pending claims.</strong><small>Employee claims will appear here for review.</small></div></td></tr>
                    }
                    @foreach (var claim in Model.PendingClaims)
                    {
                        <tr>
                            <td>#@claim.ClaimId</td>
                            <td class="fw-semibold">@claim.Employee?.FirstName @claim.Employee?.LastName</td>
                            <td>@claim.AssignedPolicy?.Policy?.PolicyName</td>
                            <td>PKR @claim.ClaimAmount.ToString("N0")</td>
                            <td><span class="status-pill status-waiting">@claim.Status</span></td>
                            <td><a asp-action="ClaimDetails" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-secondary action-button"><i class="bi bi-eye"></i><span>Review</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>
