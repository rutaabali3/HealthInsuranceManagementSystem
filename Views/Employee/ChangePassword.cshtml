@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-key-fill me-2"></i>Change Password</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="app-validation-summary d-none"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group app-field-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" id="currentPassword" class="form-control" placeholder="Current password" />
                            <button type="button" class="password-visibility-toggle" data-password-toggle="#currentPassword"
                                    aria-label="Show current password" aria-pressed="false" title="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group app-field-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="NewPassword" id="newPassword" class="form-control" placeholder="8+ chars, number and symbol" />
                            <button type="button" class="password-visibility-toggle" data-password-toggle="#newPassword"
                                    aria-label="Show new password" aria-pressed="false" title="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group app-field-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" />
                            <button type="button" class="password-visibility-toggle" data-password-toggle="#confirmPassword"
                                    aria-label="Show confirm password" aria-pressed="false" title="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-shield-check me-2"></i>Update Password
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
