@model Policy
@{
    ViewData["Title"] = "Policy Details";
}

<section class="policy-detail-shell">
    <header class="policy-detail-hero">
        <div class="policy-hero-copy">
            <a asp-action="SearchPolicy" class="policy-back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Back to search</span>
            </a>
            <div class="policy-title-row">
                <span class="policy-icon"><i class="bi bi-shield-check"></i></span>
                <div>
                    <p class="policy-eyebrow">@Model.PolicyType Policy</p>
                    <h1>@Model.PolicyName</h1>
                </div>
            </div>
            <div class="policy-meta-row">
                <span><i class="bi bi-building"></i>@(Model.Company?.CompanyName ?? "Insurance company")</span>
                <span><i class="bi bi-calendar-check"></i>@Model.DurationMonths months</span>
                <span><i class="bi bi-activity"></i>@(Model.IsActive ? "Available" : "Inactive")</span>
            </div>
        </div>
        <div class="policy-hero-action">
            <span>Annual premium</span>
            <strong>PKR @Model.PremiumAmount.ToString("N0")</strong>
            <a asp-action="OrderInsurance" asp-route-policyId="@Model.PolicyId" class="btn btn-primary">
                <i class="bi bi-send"></i><span>Request Policy</span>
            </a>
        </div>
    </header>

    <section class="policy-metric-grid" aria-label="Policy highlights">
        <article class="policy-metric">
            <span class="metric-icon metric-blue"><i class="bi bi-cash-stack"></i></span>
            <div>
                <strong>PKR @Model.PremiumAmount.ToString("N0")</strong>
                <span>Annual Premium</span>
            </div>
        </article>
        <article class="policy-metric">
            <span class="metric-icon metric-green"><i class="bi bi-hospital"></i></span>
            <div>
                <strong>PKR @Model.CoverageAmount.ToString("N0")</strong>
                <span>Total Coverage</span>
            </div>
        </article>
        <article class="policy-metric">
            <span class="metric-icon metric-coral"><i class="bi bi-clock-history"></i></span>
            <div>
                <strong>@Model.DurationMonths</strong>
                <span>Months Duration</span>
            </div>
        </article>
    </section>

    <div class="policy-content-grid">
        <section class="policy-main-column">
            <article class="policy-section">
                <div class="policy-section-heading">
                    <span><i class="bi bi-info-circle"></i></span>
                    <h2>Policy Overview</h2>
                </div>
                <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description is available for this policy yet." : Model.Description)</p>
            </article>

            <article class="policy-section">
                <div class="policy-section-heading">
                    <span><i class="bi bi-check2-all"></i></span>
                    <h2>Benefits</h2>
                </div>
                <p>@(string.IsNullOrWhiteSpace(Model.Benefits) ? "Benefits have not been listed for this policy yet." : Model.Benefits)</p>
            </article>

        </section>

        <aside class="policy-side-column" aria-label="Policy summary">
            <article class="policy-summary-panel">
                <h2>Quick Summary</h2>
                <dl>
                    <dt>Policy ID</dt>
                    <dd>#@Model.PolicyId</dd>
                    <dt>Type</dt>
                    <dd>@Model.PolicyType</dd>
                    <dt>Company</dt>
                    <dd>@(Model.Company?.CompanyName ?? "-")</dd>
                    <dt>Status</dt>
                    <dd>@(Model.IsActive ? "Available" : "Inactive")</dd>
                </dl>
                <a asp-action="OrderInsurance" asp-route-policyId="@Model.PolicyId" class="btn btn-primary w-100">
                    <i class="bi bi-send"></i><span>Request This Policy</span>
                </a>
            </article>
        </aside>
    </div>
</section>
