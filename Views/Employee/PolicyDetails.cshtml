@model Policy
@{ ViewData["Title"] = "Policy Details"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Header -->
        <div class="card border-0 shadow-sm mb-4"
             style="background: linear-gradient(135deg,#0d6efd,#0a58ca); color:white;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h3 class="fw-bold mb-1">@Model.PolicyName</h3>
                        <p class="mb-1 opacity-75">
                            <i class="bi bi-building me-1"></i>@Model.Company?.CompanyName
                        </p>
                        <span class="badge bg-white text-primary">@Model.PolicyType</span>
                    </div>
                    <a asp-action="OrderInsurance" asp-route-policyId="@Model.PolicyId"
                       class="btn btn-light fw-semibold">
                        <i class="bi bi-send me-2"></i>Request This Policy
                    </a>
                </div>
            </div>
        </div>

        <!-- Key Figures -->
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-danger fw-bold fs-5">PKR @Model.PremiumAmount.ToString("N0")</div>
                    <div class="text-muted small">Annual Premium</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-success fw-bold fs-5">PKR @Model.CoverageAmount.ToString("N0")</div>
                    <div class="text-muted small">Total Coverage</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-primary fw-bold fs-5">@Model.DurationMonths mo.</div>
                    <div class="text-muted small">Duration</div>
                </div>
            </div>
        </div>

        <!-- Description & Benefits -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="fw-semibold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Description</h5>
                <p class="text-muted">@(Model.Description ?? "No description available.")</p>

                @if (!string.IsNullOrEmpty(Model.Benefits))
                {
                    <h5 class="fw-semibold mt-4 mb-3"><i class="bi bi-check2-all me-2 text-success"></i>Benefits</h5>
                    <p class="text-muted">@Model.Benefits</p>
                }
            </div>
        </div>

        <!-- Coverage Breakdown -->
        @if (Model.PolicyDescriptions.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-list-check me-2 text-info"></i>Coverage Breakdown</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Coverage Type</th>
                                    <th>Max Limit (PKR)</th>
                                    <th>Claim Details</th>
                                    <th>Exclusions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.PolicyDescriptions)
                                {
                                    <tr>
                                        <td class="fw-semibold">@d.CoverageType</td>
                                        <td>@d.MaxLimit.ToString("N0")</td>
                                        <td class="text-muted small">@(d.ClaimProcess ?? "Not specified")</td>
                                        <td class="text-muted small">@(d.Exclusions ?? "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex gap-2">
            <a asp-action="OrderInsurance" asp-route-policyId="@Model.PolicyId"
               class="btn btn-primary px-4">
                <i class="bi bi-send me-2"></i>Request This Policy
            </a>
            <a asp-action="SearchPolicy" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>Back to Search
            </a>
        </div>
    </div>
</div>
