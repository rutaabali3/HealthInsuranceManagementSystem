@model EmpRegister
@{ ViewData["Title"] = "Update My Details"; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-pencil-square me-2"></i>Update My Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateDetails" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EmpId" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="PasswordHash" />
                    <input type="hidden" asp-for="Department" />
                    <input type="hidden" asp-for="FirstName" />
                    <input type="hidden" asp-for="LastName" />
                    <input type="hidden" asp-for="DateOfBirth" />
                    <input type="hidden" asp-for="Gender" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Designation" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="Designation" class="form-control" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                        <a asp-action="Details" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
