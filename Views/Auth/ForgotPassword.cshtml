@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; Layout = "_Layout"; }

<section class="password-recovery-shell" aria-labelledby="forgot-password-title">
    <div class="password-recovery-card">
        <div class="password-recovery-header">
            <span class="password-recovery-icon"><i class="bi bi-envelope-at"></i></span>
            <h1 id="forgot-password-title">Forgot Password</h1>
            <p>Enter your account email and we will send a password reset link.</p>
        </div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="app-validation-summary d-none"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <div class="input-group app-field-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary password-recovery-submit">
                <i class="bi bi-send"></i>
                <span>Send Reset Link</span>
            </button>

            <a asp-controller="Auth" asp-action="Login" class="password-recovery-back">
                <i class="bi bi-arrow-left"></i>
                <span>Back to login</span>
            </a>
        </form>
    </div>
</section>
