@model Policy
@{ ViewData["Title"] = "Add Policy"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-file-plus me-2"></i>Add New Policy</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddPolicy" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="app-validation-summary d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyId" class="form-label fw-semibold">Insurance Company</label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <select asp-for="CompanyId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.Companies, "CompanyId", "CompanyName"))">
                                    <option value="">-- Select Company --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CompanyId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PolicyName" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="PolicyName" class="form-control" placeholder="e.g. Gold Health Plan" />
                            </div>
                            <span asp-validation-for="PolicyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PolicyType" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-tags"></i></span>
                                <select asp-for="PolicyType" class="form-select">
                                    <option value="">-- Select --</option>
                                    <option value="Individual">Individual</option>
                                    <option value="Family">Family</option>
                                    <option value="Group">Group</option>
                                    <option value="Senior">Senior</option>
                                </select>
                            </div>
                            <span asp-validation-for="PolicyType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PremiumAmount" class="form-label fw-semibold">Premium (PKR/year)</label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-cash-stack"></i></span>
                                <input asp-for="PremiumAmount" class="form-control" type="number" min="0" step="100" />
                            </div>
                            <span asp-validation-for="PremiumAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CoverageAmount" class="form-label fw-semibold">Coverage (PKR)</label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-umbrella"></i></span>
                                <input asp-for="CoverageAmount" class="form-control" type="number" min="0" step="1000" />
                            </div>
                            <span asp-validation-for="CoverageAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DurationMonths" class="form-label fw-semibold">Duration (Months)</label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                                <input asp-for="DurationMonths" class="form-control" type="number" min="1" max="60" />
                            </div>
                            <span asp-validation-for="DurationMonths" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Benefits" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-stars"></i></span>
                                <textarea asp-for="Benefits" class="form-control" rows="2"
                                          placeholder="e.g. Hospitalization, OPD, Dental, Vision..."></textarea>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                <textarea asp-for="Description" class="form-control" rows="3"
                                          placeholder="Full policy description..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-save me-2"></i>Save Policy
                        </button>
                        <a asp-action="Policies" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
