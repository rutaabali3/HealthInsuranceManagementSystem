@model List<PolicyRequestDetails>
@{ ViewData["Title"] = "Policy Requests"; }

<h2 class="fw-bold mb-4"><i class="bi bi-inbox-fill text-primary me-2"></i>Policy Requests</h2>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Employee</th>
                        <th>Policy</th>
                        <th>Company</th>
                        <th>Bill</th>
                        <th>Requested</th>
                        <th>Status</th>
                        <th>Handled By</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="admin-empty-state">
                                    <div class="admin-empty-illustration">
                                        <i class="bi bi-file-earmark-check"></i>
                                        <span><i class="bi bi-check-lg"></i></span>
                                    </div>
                                    <h3>No requests yet.</h3>
                                    <p>Policy requests will appear here once submitted.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.RequestId</td>
                            <td class="fw-semibold">@r.Employee?.FirstName @r.Employee?.LastName</td>
                            <td>@r.Policy?.PolicyName</td>
                            <td>@r.Policy?.Company?.CompanyName</td>
                            <td>PKR @r.BillAmount.ToString("N0")</td>
                            <td>@r.RequestedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(r.Status=="Pending"?"bg-warning text-dark":r.Status=="Rejected"?"bg-danger":r.Status=="Closed"?"bg-dark":"bg-success")">
                                    @r.Status
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    Manager: @(r.Approval?.Decision ?? "Waiting")
                                    @if (r.Bill?.FinanceManagerId != null)
                                    {
                                        <span class="d-block">Finance: @r.Bill.Status</span>
                                    }
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
