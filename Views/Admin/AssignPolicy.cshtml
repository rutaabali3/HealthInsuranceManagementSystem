@model PolicyOnEmployee
@{ ViewData["Title"] = "Assign Policy"; var emp = ViewBag.Employee as EmpRegister; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-file-plus me-2"></i>Assign Policy to @emp?.FirstName @emp?.LastName
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AssignPolicy" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EmpId" />

                    <div class="mb-3">
                        <label asp-for="PolicyId" class="form-label fw-semibold">Select Policy</label>
                        <div class="input-group app-field-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <select asp-for="PolicyId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Policies, "PolicyId", "PolicyName"))">
                                <option value="">-- Choose a Policy --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-calendar-plus"></i></span>
                                <input asp-for="StartDate" class="form-control" type="date" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <div class="input-group app-field-group">
                                <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                                <input asp-for="EndDate" class="form-control" type="date" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-lg me-2"></i>Assign
                        </button>
                        <a asp-action="Employees" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
