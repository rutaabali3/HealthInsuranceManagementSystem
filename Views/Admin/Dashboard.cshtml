@using System.Globalization
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var username = Context.Session.GetString("Username") ?? "admin";
    var today = DateTime.Now;
    var trend = Model.OverviewTrend.Any()
        ? Model.OverviewTrend
        : new List<DashboardTrendPoint> { new DashboardTrendPoint { Date = today.Date, Value = 0 } };
    const double chartLeft = 42;
    const double chartRight = 735;
    const double chartTop = 22;
    const double chartBottom = 206;
    var maxValue = Math.Max(4, trend.Max(point => point.Value));
    var maxAxisValue = (int)Math.Ceiling(maxValue / 4.0) * 4;
    var chartSpan = Math.Max(1, trend.Count - 1);
    var chartPoints = trend.Select((point, index) =>
    {
        var x = chartLeft + ((chartRight - chartLeft) * index / chartSpan);
        var y = chartBottom - ((chartBottom - chartTop) * point.Value / maxAxisValue);
        return new { point.Date, point.Value, X = x, Y = y };
    }).ToList();
    var polylinePoints = string.Join(" ", chartPoints.Select(point =>
        $"{point.X.ToString("0.##", CultureInfo.InvariantCulture)},{point.Y.ToString("0.##", CultureInfo.InvariantCulture)}"));
    var areaPath = $"M {polylinePoints.Replace(" ", " L ")} L {chartRight.ToString("0.##", CultureInfo.InvariantCulture)} {chartBottom.ToString("0.##", CultureInfo.InvariantCulture)} L {chartLeft.ToString("0.##", CultureInfo.InvariantCulture)} {chartBottom.ToString("0.##", CultureInfo.InvariantCulture)} Z";
    var axisLabels = new[] { maxAxisValue, maxAxisValue * 3 / 4, maxAxisValue / 2, maxAxisValue / 4, 0 };
    var xLabelIndexes = trend.Count == 1
        ? new List<int> { 0 }
        : new[] { 0, trend.Count / 4, trend.Count / 2, trend.Count * 3 / 4, trend.Count - 1 }.Distinct().ToList();
    var xAxisLabels = xLabelIndexes.Select(index => chartPoints[index]).ToList();
}

<section class="admin-dashboard-shell">
    <header class="dashboard-hero">
        <div>
            <p class="dashboard-eyebrow">Welcome back, @username!</p>
            <h1>Admin Dashboard</h1>
            <p class="dashboard-subtitle">Here's what's happening with your health insurance system today.</p>
        </div>
        <div class="dashboard-date-chip" aria-label="Current date">
            <i class="bi bi-calendar3"></i>
            <span>@today.ToString("MMMM d, yyyy")</span>
        </div>
    </header>

    <section class="metric-grid" aria-label="Dashboard metrics">
        <a asp-action="Employees" class="metric-card metric-card-teal">
            <span class="metric-icon"><i class="bi bi-people"></i></span>
            <span class="metric-content">
                <strong>@Model.TotalEmployees</strong>
                <span class="metric-title">Employees</span>
            </span>
        </a>
        <a asp-action="Companies" class="metric-card metric-card-green">
            <span class="metric-icon"><i class="bi bi-building-gear"></i></span>
            <span class="metric-content">
                <strong>@Model.TotalCompanies</strong>
                <span class="metric-title">Companies</span>
            </span>
        </a>
        <a asp-action="Policies" class="metric-card metric-card-blue">
            <span class="metric-icon"><i class="bi bi-shield-check"></i></span>
            <span class="metric-content">
                <strong>@Model.TotalPolicies</strong>
                <span class="metric-title">Policies</span>
            </span>
        </a>
        <a asp-action="PolicyRequests" class="metric-card metric-card-amber">
            <span class="metric-icon"><i class="bi bi-hourglass-split"></i></span>
            <span class="metric-content">
                <strong>@Model.PendingRequests</strong>
                <span class="metric-title">Pending Requests</span>
            </span>
        </a>
        <a asp-controller="Report" asp-action="Index" class="metric-card metric-card-purple">
            <span class="metric-icon"><i class="bi bi-file-earmark-text"></i></span>
            <span class="metric-content">
                <strong>@Model.PendingBills</strong>
                <span class="metric-title">Bills in Flow</span>
            </span>
        </a>
    </section>

    <section class="dashboard-main-grid">
        <article class="dashboard-panel recent-panel">
            <div class="panel-heading">
                <h2><i class="bi bi-clock"></i>Recent Policy Requests</h2>
                <a asp-action="PolicyRequests" class="panel-action">View All</a>
            </div>
            <div class="panel-body">
                @if (!Model.RecentRequests.Any())
                {
                    <div class="empty-state">
                        <div class="empty-illustration">
                            <i class="bi bi-file-earmark-check"></i>
                            <span><i class="bi bi-check-lg"></i></span>
                        </div>
                        <h3>No requests yet.</h3>
                        <p>Policy requests will appear here once submitted.</p>
                    </div>
                }
                else
                {
                    <div class="request-list">
                        @foreach (var request in Model.RecentRequests.Take(4))
                        {
                            <a asp-action="PolicyRequests" class="request-row">
                                <span>
                                    <strong>@request.Employee?.FirstName @request.Employee?.LastName</strong>
                                    <small>@request.Policy?.PolicyName</small>
                                </span>
                                <span class="request-meta">
                                    <time>@request.RequestedAt.ToString("MMM d")</time>
                                    <em>@request.Status</em>
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        </article>

        <article class="dashboard-panel overview-panel">
            <div class="panel-heading">
                <h2><i class="bi bi-graph-up-arrow"></i>System Overview</h2>
                <button type="button" class="panel-filter">This Month <i class="bi bi-chevron-down"></i></button>
            </div>
            <div class="overview-body">
                <svg class="overview-chart" viewBox="0 0 760 220" role="img" aria-label="System overview trend chart" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="overviewFill" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="#007a7a" stop-opacity="0.18" />
                            <stop offset="100%" stop-color="#007a7a" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <g class="chart-grid">
                        <line x1="42" y1="22" x2="735" y2="22" />
                        <line x1="42" y1="68" x2="735" y2="68" />
                        <line x1="42" y1="114" x2="735" y2="114" />
                        <line x1="42" y1="160" x2="735" y2="160" />
                        <line x1="42" y1="206" x2="735" y2="206" />
                    </g>
                    <g class="chart-axis">
                        @for (var i = 0; i < axisLabels.Length; i++)
                        {
                            var y = 28 + (i * 46);
                            @Html.Raw($"<text x=\"{(axisLabels[i] < 10 ? 10 : 0)}\" y=\"{y}\">{axisLabels[i]}</text>")
                        }
                    </g>
                    <path class="chart-area" d="@areaPath" />
                    <polyline class="chart-line" points="@polylinePoints" />
                    <g class="chart-dots">
                        @foreach (var point in chartPoints)
                        {
                            <circle cx="@(point.X.ToString("0.##", CultureInfo.InvariantCulture))"
                                    cy="@(point.Y.ToString("0.##", CultureInfo.InvariantCulture))"
                                    r="5">
                                <title>@point.Date.ToString("MMM d"): @point.Value activity items</title>
                            </circle>
                        }
                    </g>
                </svg>
                <div class="chart-date-row" aria-hidden="true">
                    @foreach (var label in xAxisLabels)
                    {
                        var left = ((label.X - chartLeft) / (chartRight - chartLeft) * 100).ToString("0.##", CultureInfo.InvariantCulture);
                        <span style="left: @left%">@label.Date.ToString("MMM d")</span>
                    }
                </div>

                <div class="overview-stat-grid">
                    <div>
                        <span>New Employees</span>
                        <strong>@Model.NewEmployeesThisMonth</strong>
                        <em>This month</em>
                    </div>
                    <div>
                        <span>New Policies</span>
                        <strong>@Model.NewPoliciesThisMonth</strong>
                        <em>This month</em>
                    </div>
                    <div>
                        <span>Claims Processed</span>
                        <strong>@Model.ClaimsProcessedThisMonth</strong>
                        <em>This month</em>
                    </div>
                    <div>
                        <span>Bills Generated</span>
                        <strong>@Model.BillsGeneratedThisMonth</strong>
                        <em>This month</em>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dashboard-panel quick-actions-panel">
        <div class="panel-heading">
            <h2><i class="bi bi-lightning-charge"></i>Quick Actions</h2>
        </div>
        <div class="quick-action-grid">
            <a asp-action="AddCompany" class="quick-action action-teal">
                <span><i class="bi bi-building-add"></i></span>
                <span><strong>Add Company</strong><small>Register a new insurance company</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-action="AddPolicy" class="quick-action action-green">
                <span><i class="bi bi-file-earmark-plus"></i></span>
                <span><strong>Add Policy</strong><small>Create a new policy</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-action="RegisterEmployee" class="quick-action action-blue">
                <span><i class="bi bi-person-plus"></i></span>
                <span><strong>Register Employee</strong><small>Add a new employee</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-controller="Report" asp-action="Index" class="quick-action action-amber">
                <span><i class="bi bi-bar-chart"></i></span>
                <span><strong>Reports</strong><small>View system reports</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-action="Search" class="quick-action action-purple">
                <span><i class="bi bi-search"></i></span>
                <span><strong>Search</strong><small>Search across records</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </section>
</section>
